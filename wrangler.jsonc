{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vicine",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": ".open-next/worker.js",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vicine",
    },
  ],
  "kv_namespaces": [
    // KV incremental cache (ISR). This account is on the Workers free plan, so
    // R2 (the OpenNext default) is unavailable — KV works on free tier.
    // Namespace created via `wrangler kv namespace create`.
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "dfc551a12f324091ac7560da2c4b6294",
    },
  ],
}
